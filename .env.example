# ============================================================
#  Unified Threat Sandbox — Environment Variables Template
#  Copy this file to `.env` and fill in your values.
#  NEVER commit the actual `.env` file to version control.
# ============================================================

# --- Flask Application Security ---
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
THREAT_SANDBOX_SECRET=replace_with_a_secure_random_64_character_hex_key

# --- VirtualBox Guest Credentials ---
# Password for the guest VM user account used by VBoxManage guestcontrol
VBOX_GUEST_PASS=SandboxPass@2026!

# --- VirusTotal API (Optional — ENH-001) ---
VT_API_KEY=REPLACE_WITH_YOUR_VIRUSTOTAL_API_KEY

# --- AbuseIPDB API (Optional — ENH-007) ---
ABUSEIPDB_KEY=REPLACE_WITH_YOUR_ABUSEIPDB_API_KEY

# --- AlienVault OTX API (Optional — ENH-007) ---
OTX_API_KEY=REPLACE_WITH_YOUR_OTX_API_KEY
